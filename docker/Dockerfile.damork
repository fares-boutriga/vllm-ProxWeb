# syntax=docker/dockerfile:1.7
# SPDX-License-Identifier: Apache-2.0

# Damork/vLLM deployment image.
#
# Build:
#   docker build -f docker/Dockerfile.damork -t damork-vllm:0.1 .
#
# Run:
#   docker run --gpus all --ipc=host --shm-size=8g -p 8000:8000 damork-vllm:0.1

ARG BASE_IMAGE=vllm/vllm-openai:latest
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    VLLM_USE_FLASHINFER_SAMPLER=0 \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    DAMORK_MODEL=PWLabs/Qwen3.5-0.8B \
    DAMORK_SERVED_MODEL_NAME=damork \
    DAMORK_HOST=0.0.0.0 \
    DAMORK_PORT=8000 \
    DAMORK_MAX_MODEL_LEN=2048 \
    DAMORK_GPU_MEMORY_UTILIZATION=0.85

WORKDIR /workspace/vllm-ProxWeb

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY docker/install-damork-patch.py /tmp/damork-patch/install-damork-patch.py
COPY vllm/transformers_utils/processors/damork_vl.py /tmp/damork-patch/vllm/transformers_utils/processors/damork_vl.py

RUN python3 /tmp/damork-patch/install-damork-patch.py \
    && rm -rf /tmp/damork-patch

COPY docker/damork-entrypoint.sh /usr/local/bin/damork-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/damork-entrypoint \
    && chmod +x /usr/local/bin/damork-entrypoint

EXPOSE 8000

ENTRYPOINT ["damork-entrypoint"]
